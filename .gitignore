/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
/.installed.cfg
/MANIFEST
*.egg-info/
*.egg

# Unit test / coverage reports
.cache
.coverage
.coverage.*
.hypothesis/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py,cover

# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

